# lightturret.ftl for locale mn. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Гэрлийн цамхаг
# Intro
lightturret-intro = Гэрлийн цамхаг эхэллээ! Тоглогч бүр { $power } хүчтэй цамхагтай. Гэрэл болон зоос олохын тулд цамхаг буудаарай, гэхдээ хэрэв таны гэрэл хүчээ давбал, та хасагдна! Хүчээ нэмэгдүүлэхийн тулд зоосоор сайжруулалт худалдан аваарай. Төгсгөлд хамгийн их гэрэлтэй тоглогч ялна!
# Actions
lightturret-shoot = Цамхаг буудах
lightturret-upgrade = Сайжруулалт худалдаж авах (10 зоос)
lightturret-check-stats = Статистик шалгах
lightturret-not-enough-coins = Танд хангалттай зоос байхгүй байна! { $need } зоос хэрэгтэй боловч зөвхөн { $have } байна.
# Disabled action reasons
lightturret-you-are-eliminated = Та хасагдсан байна.
# Stats
lightturret-stats-alive = { $player }: { $power } хүч, { $light } гэрэл, { $coins } зоос.
lightturret-stats-eliminated = { $player }: { $light } гэрэлтэй байхдаа хасагдсан.
# Options
lightturret-set-starting-power = Эхлэх хүч: { $power }
lightturret-enter-starting-power = Эхлэх хүчийг оруулна уу:
lightturret-option-changed-power = Эхлэх хүч { $power } болж өөрчлөгдлөө.
lightturret-set-max-rounds = Хамгийн их тойрог: { $rounds }
lightturret-enter-max-rounds = Хамгийн их тойрог оруулна уу:
lightturret-option-changed-rounds = Хамгийн их тойрог { $rounds } болж өөрчлөгдлөө.
