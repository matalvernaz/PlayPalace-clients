# ninetynine.ftl for locale mn. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Тоглоомын нэрс
game-name-ninetynine = Ерэн есөн
# Тойрог
ninetynine-round = { $round } дугаар тойрог.
# Хөзөр тавих - v10-тай яг тохирно
ninetynine-you-play = Та { $card } тавина. Тоо одоо { $count } болов.
ninetynine-player-plays = { $player } { $card } тавина. Тоо одоо { $count } болов.
# Чиглэл буцаах
ninetynine-direction-reverses = Тоглолтын чиглэл буцаж байна!
# Алгасах
ninetynine-player-skipped = { $player } алгасагдав.
# Токен алдагдал - v10-тай яг тохирно
ninetynine-you-lose-tokens =
    Та { $amount } { $amount ->
        [one] токен
       *[other] токен
    } алдана.
ninetynine-player-loses-tokens =
    { $player } { $amount } { $amount ->
        [one] токен
       *[other] токен
    } алдана.
# Хасагдах
ninetynine-player-eliminated = { $player } хасагдсан байна!
# Тоглоом дуусах
ninetynine-player-wins = { $player } тоглоомыг ялна!
# Хөзөр татах
ninetynine-you-draw = Та { $card } татна.
ninetynine-player-draws = { $player } хөзөр татна.
# Хүчинтэй хөзөр алга
ninetynine-no-valid-cards = { $player }-д 99-өөс давахгүй хөзөр алга!
# Статус - C товчлуурт зориулсан
ninetynine-current-count = Тоо { $count } байна.
# Туз сонгох
ninetynine-ace-choice = Тузыг +1 эсвэл +11-р тавих уу?
ninetynine-ace-add-eleven = 11 нэмэх
ninetynine-ace-add-one = 1 нэмэх
# Арав сонгох
ninetynine-ten-choice = 10-г +10 эсвэл -10-р тавих уу?
ninetynine-ten-add = 10 нэмэх
ninetynine-ten-subtract = 10 хасах
# Гараар татах
ninetynine-draw-card = Хөзөр татах
ninetynine-draw-prompt = Хөзөр татахын тулд Space эсвэл D дарна уу.
# Сонголтууд
ninetynine-set-tokens = Эхлэх токен: { $tokens }
ninetynine-enter-tokens = Эхлэх токены тоог оруулна уу:
ninetynine-option-changed-tokens = Эхлэх токен { $tokens } болгов.
ninetynine-set-rules = Дүрмийн хувилбар: { $rules }
ninetynine-select-rules = Дүрмийн хувилбар сонгох
ninetynine-option-changed-rules = Дүрмийн хувилбар { $rules } болгов.
ninetynine-set-hand-size = Гарын хэмжээ: { $size }
ninetynine-enter-hand-size = Гарын хэмжээ оруулна уу:
ninetynine-option-changed-hand-size = Гарын хэмжээ { $size } болгов.
ninetynine-set-autodraw = Автомат татах: { $enabled }
ninetynine-option-changed-autodraw = Автомат татах { $enabled } болгов.
# Үйлдэл хийх боломжгүй шалтгаанууд
ninetynine-choose-first = Та эхлээд сонголт хийх хэрэгтэй.
