# leftrightcenter.ftl for locale mn. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-leftrightcenter = Зүүн Баруун Төв
# Actions
lrc-roll =
    { $count } { $count ->
        [one] шоо
       *[other] шоо
    } шидэх
# Dice faces
lrc-face-left = Зүүн
lrc-face-center = Төв
lrc-face-right = Баруун
lrc-face-dot = Цэг
lrc-center-pot =
    Төвд { $count } { $count ->
        [one] чип
       *[other] чип
    } байна.
# Options
lrc-set-starting-chips = Эхлэх чип: { $count }
lrc-enter-starting-chips = Эхлэх чип оруулна уу:
lrc-option-changed-starting-chips = Эхлэх чип { $count } болов.
