# lightturret.ftl for locale zu. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Light Turret
# Intro
lightturret-intro = I-Light Turret isiqalile! Umdlali ngamunye unethurret elinamandla angu-{ $power }. Dubula ithurret ukuze uthole ukukhanya nama-coins, kodwa uma ukukhanya kwakho kudlula amandla akho, uyakhishwa! Thenga ukuthuthukiswa ngama-coins ukwandisa amandla akho. Umdlali onokukhanya okuningi ekupheleni uwina!
# Actions
lightturret-shoot = Dubula ithurret
lightturret-upgrade = Thenga ukuthuthukiswa (ama-coins angu-10)
lightturret-check-stats = Bheka izibalo
lightturret-not-enough-coins = Awunayo ama-coins anele! Udinga ama-coins angu-{ $need } kodwa unama-{ $have } kuphela.
# Disabled action reasons
lightturret-you-are-eliminated = Ukhishiwe.
# Stats
lightturret-stats-alive = { $player }: amandla angu-{ $power }, ukukhanya okungu-{ $light }, ama-coins angu-{ $coins }.
lightturret-stats-eliminated = { $player }: ukhishwe nokukhanya okungu-{ $light }.
# Options
lightturret-set-starting-power = Amandla okuqala: { $power }
lightturret-enter-starting-power = Faka amandla okuqala:
lightturret-option-changed-power = Amandla okuqala asetelwe ku-{ $power }.
lightturret-set-max-rounds = Imijikelezo ephezulu: { $rounds }
lightturret-enter-max-rounds = Faka imijikelezo ephezulu:
lightturret-option-changed-rounds = Imijikelezo ephezulu isetelwe ku-{ $rounds }.
