# lightturret.ftl for locale sk. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Svetelná Veža
# Intro
lightturret-intro = Svetelná Veža začala! Každý hráč má vežu s { $power } sily. Strieľajte do veže, aby ste získali svetlo a mince, ale ak vaše svetlo presiahne vašu silu, ste vyradení! Kupujte vylepšenia mincami, aby ste zvýšili svoju silu. Hráč s najväčším svetlom na konci vyhrá!
# Actions
lightturret-shoot = Strieľať do veže
lightturret-upgrade = Kúpiť vylepšenie (10 mincí)
lightturret-check-stats = Skontrolovať štatistiky
lightturret-not-enough-coins = Nemáte dostatok mincí! Potrebujete { $need } mincí, ale máte len { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Boli ste vyradení.
# Stats
lightturret-stats-alive = { $player }: { $power } sily, { $light } svetla, { $coins } mincí.
lightturret-stats-eliminated = { $player }: vyradený so { $light } svetla.
# Options
lightturret-set-starting-power = Počiatočná sila: { $power }
lightturret-enter-starting-power = Zadajte počiatočnú silu:
lightturret-option-changed-power = Počiatočná sila nastavená na { $power }.
lightturret-set-max-rounds = Maximálne kolá: { $rounds }
lightturret-enter-max-rounds = Zadajte maximálne kolá:
lightturret-option-changed-rounds = Maximálne kolá nastavené na { $rounds }.
