# midnight.ftl for locale ro. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game info
game-name-midnight = 1-4-24
# Actions
midnight-roll = Aruncați zarurile
midnight-bank = Confirmați
midnight-you-rolled = Ați aruncat: { $dice }.
midnight-player-rolled = { $player } a aruncat: { $dice }.
# Keeping dice
midnight-you-keep = Păstrați { $die }.
midnight-player-keeps = { $player } păstrează { $die }.
midnight-you-unkeep = Eliberați { $die }.
midnight-player-unkeeps = { $player } eliberează { $die }.
# Scoring
midnight-you-scored = Ați marcat { $score } puncte.
midnight-scored = { $player } a marcat { $score } puncte.
midnight-you-disqualified = Nu aveți atât 1, cât și 4. Descalificat!
midnight-player-disqualified = { $player } nu are atât 1, cât și 4. Descalificat!
# Round results
midnight-round-winner = { $player } câștigă runda!
midnight-round-tie = Rundă egală între { $players }.
midnight-all-disqualified = Toți jucătorii descalificați! Niciun câștigător în această rundă.
# Game winner
midnight-game-winner = { $player } câștigă jocul cu { $wins } victorii de rundă!
midnight-game-tie = Egalitate! { $players } au câștigat fiecare { $wins } runde.
# Options
midnight-set-rounds = Runde de jucat: { $rounds }
midnight-enter-rounds = Introduceți numărul de runde de jucat:
midnight-option-changed-rounds = Runde de jucat schimbate la { $rounds }
# Disabled reasons
midnight-need-to-roll = Trebuie să aruncați zarurile mai întâi.
midnight-no-dice-to-keep = Niciun zar disponibil de păstrat.
midnight-must-keep-one = Trebuie să păstrați cel puțin un zar per aruncare.
midnight-must-roll-first = Trebuie să aruncați zarurile mai întâi.
midnight-keep-all-first = Trebuie să păstrați toate zarurile înainte de confirmare.
