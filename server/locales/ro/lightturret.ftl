# lightturret.ftl for locale ro. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Turnul Luminii
# Intro
lightturret-intro = Turnul Luminii a început! Fiecare jucător are un turn cu { $power } putere. Trageți în turn pentru a câștiga lumină și monede, dar dacă lumina voastră depășește puterea voastră, sunteți eliminat! Cumpărați îmbunătățiri cu monede pentru a vă crește puterea. Jucătorul cu cea mai multă lumină la sfârșit câștigă!
# Actions
lightturret-shoot = Trageți în turn
lightturret-upgrade = Cumpărați o îmbunătățire (10 monede)
lightturret-check-stats = Verificați statisticile
lightturret-not-enough-coins = Nu aveți suficiente monede! Aveți nevoie de { $need } monede, dar aveți doar { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Ați fost eliminat.
# Stats
lightturret-stats-alive = { $player }: { $power } putere, { $light } lumină, { $coins } monede.
lightturret-stats-eliminated = { $player }: eliminat cu { $light } lumină.
# Options
lightturret-set-starting-power = Putere inițială: { $power }
lightturret-enter-starting-power = Introduceți puterea inițială:
lightturret-option-changed-power = Putere inițială setată la { $power }.
lightturret-set-max-rounds = Runde maxime: { $rounds }
lightturret-enter-max-rounds = Introduceți rundele maxime:
lightturret-option-changed-rounds = Runde maxime setate la { $rounds }.
