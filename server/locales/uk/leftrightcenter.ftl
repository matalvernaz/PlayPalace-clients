# leftrightcenter.ftl for locale uk. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-leftrightcenter = Ліво Право Центр
# Actions
lrc-roll =
    Кинути { $count } { $count ->
        [one] кубик
       *[other] кубиків
    }
# Dice faces
lrc-face-left = Ліво
lrc-face-center = Центр
lrc-face-right = Право
lrc-face-dot = Крапка
lrc-center-pot =
    { $count } { $count ->
        [one] фішка
       *[other] фішок
    } в центрі.
# Options
lrc-set-starting-chips = Початкові фішки: { $count }
lrc-enter-starting-chips = Введіть початкові фішки:
lrc-option-changed-starting-chips = Початкові фішки встановлено на { $count }.
