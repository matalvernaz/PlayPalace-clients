# lightturret.ftl for locale uk. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Світлова вежа
# Intro
lightturret-intro = Світлова вежа розпочалася! У кожного гравця є вежа з { $power } потужності. Стріляйте по вежі, щоб отримати світло та монети, але якщо ваше світло перевищить вашу потужність, ви вибуваєте! Купуйте покращення за монети, щоб збільшити свою потужність. Гравець з найбільшою кількістю світла в кінці виграє!
# Actions
lightturret-shoot = Стріляти по вежі
lightturret-upgrade = Купити покращення (10 монет)
lightturret-check-stats = Перевірити статистику
lightturret-not-enough-coins = У вас недостатньо монет! Потрібно { $need } монет, а у вас лише { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Ви вибули.
# Stats
lightturret-stats-alive = { $player }: { $power } потужності, { $light } світла, { $coins } монет.
lightturret-stats-eliminated = { $player }: вибув з { $light } світла.
# Options
lightturret-set-starting-power = Початкова потужність: { $power }
lightturret-enter-starting-power = Введіть початкову потужність:
lightturret-option-changed-power = Початкова потужність встановлена на { $power }.
lightturret-set-max-rounds = Максимум раундів: { $rounds }
lightturret-enter-max-rounds = Введіть максимум раундів:
lightturret-option-changed-rounds = Максимум раундів встановлено на { $rounds }.
