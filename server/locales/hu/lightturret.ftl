# lightturret.ftl for locale hu. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Fénytorony
# Intro
lightturret-intro = A Fénytorony megkezdődött! Minden játékosnak van egy tornya { $power } erővel. Lőj a toronyra, hogy fényt és érméket szerezz, de ha a fényed meghaladja az erődet, kiesél! Vásárolj fejlesztéseket érmékkel, hogy növeld az erődet. Az a játékos nyer, akinek a végén a legtöbb fénye van!
# Actions
lightturret-shoot = Lőj a toronyra
lightturret-upgrade = Vásárolj fejlesztést (10 érme)
lightturret-check-stats = Statisztikák ellenőrzése
lightturret-not-enough-coins = Nincs elég érméd! { $need } érmére van szükség, de csak { $have } van.
# Disabled action reasons
lightturret-you-are-eliminated = Kiesett.
# Stats
lightturret-stats-alive = { $player }: { $power } erő, { $light } fény, { $coins } érme.
lightturret-stats-eliminated = { $player }: kiesett { $light } fénnyel.
# Options
lightturret-set-starting-power = Kezdő erő: { $power }
lightturret-enter-starting-power = Adja meg a kezdő erőt:
lightturret-option-changed-power = Kezdő erő beállítva: { $power }.
lightturret-set-max-rounds = Maximum körök: { $rounds }
lightturret-enter-max-rounds = Adja meg a maximum köröket:
lightturret-option-changed-rounds = Maximum körök beállítva: { $rounds }.
