# leftrightcenter.ftl for locale sr. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-leftrightcenter = Levo, desno, centar
# Actions
lrc-roll =
    Baci { $count } { $count ->
        [one] kockicu
       *[other] kockice
    }
# Dice faces
lrc-face-left = Levo
lrc-face-center = Centar
lrc-face-right = Desno
lrc-face-dot = Tačka
lrc-center-pot =
    { $count } { $count ->
        [one] žeton
       *[other] žetona
    } na centru.
# Options
lrc-set-starting-chips = Početni žetoni: { $count }
lrc-enter-starting-chips = Upišite početne žetone:
lrc-option-changed-starting-chips = Početni žetoni podešeni na { $count }.
