# lightturret.ftl for locale sr. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Svetlosna kupola
# Intro
lightturret-intro = Svetlosna kupola je počela! Svaki igrač ima kupolu sa { $power } snage. Pucajte kako biste dobijali osvetljenje i novčiće, ali ako vaše osvetljenje prevaziđe vašu snagu, ispadate! Novčićima možete kupiti pojačanja kako biste povećali vašu snagu. Igrač sa najviše osvetljenja na kraju pobeđuje!
# Actions
lightturret-shoot = Pucaj
lightturret-upgrade = Kupi pojačanje (10 novčića)
lightturret-check-stats = Proveri statistike
lightturret-not-enough-coins = Nemate dovoljno novčića! Potrebno vam je { $need } novčića ali imate samo { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Izbačeni ste.
# Stats
lightturret-stats-alive = { $player }: Snaga: { $power }, osvetljenje: { $light }, novčići: { $coins }.
lightturret-stats-eliminated = { $player }: van igre sa { $light } osvetljenja.
# Options
lightturret-set-starting-power = Početna snaga: { $power }
lightturret-enter-starting-power = Upišite početnu snagu:
lightturret-option-changed-power = Početna snaga podešena na { $power }.
lightturret-set-max-rounds = Maksimalan broj rundi: { $rounds }
lightturret-enter-max-rounds = Upišite maksimalan broj rundi:
lightturret-option-changed-rounds = Maksimalan broj rundi podešen na { $rounds }.
