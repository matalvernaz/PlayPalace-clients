# lightturret.ftl for locale fr. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Nom du jeu
game-name-lightturret = Light Turret
# Intro
lightturret-intro = Light Turret a commencé ! Chaque joueur a une tourelle avec { $power } puissance. Tirez sur la tourelle pour gagner de la lumière et des pièces, mais si votre lumière dépasse votre puissance, vous êtes éliminé ! Achetez des améliorations avec des pièces pour augmenter votre puissance. Le joueur avec le plus de lumière à la fin gagne !
# Actions
lightturret-shoot = Tirer sur la tourelle
lightturret-upgrade = Acheter une amélioration (10 pièces)
lightturret-check-stats = Vérifier les stats
lightturret-not-enough-coins = Vous n'avez pas assez de pièces ! Besoin de { $need } pièces mais n'en avez que { $have }.
# Raisons d'action désactivée
lightturret-you-are-eliminated = Vous avez été éliminé.
# Stats
lightturret-stats-alive = { $player } : { $power } puissance, { $light } lumière, { $coins } pièces.
lightturret-stats-eliminated = { $player } : éliminé avec { $light } lumière.
# Options
lightturret-set-starting-power = Puissance de départ : { $power }
lightturret-enter-starting-power = Entrez la puissance de départ :
lightturret-option-changed-power = Puissance de départ définie sur { $power }.
lightturret-set-max-rounds = Manches max : { $rounds }
lightturret-enter-max-rounds = Entrez les manches max :
lightturret-option-changed-rounds = Manches max définies sur { $rounds }.
