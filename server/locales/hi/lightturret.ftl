# lightturret.ftl for locale hi. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = लाइट टरेट
# Intro
lightturret-intro = लाइट टरेट शुरू हो गया है! प्रत्येक खिलाड़ी के पास { $power } शक्ति वाली टरेट है। प्रकाश और सिक्के प्राप्त करने के लिए टरेट को शूट करें, लेकिन यदि आपका प्रकाश आपकी शक्ति से अधिक हो जाता है, तो आप बाहर हो जाते हैं! अपनी शक्ति बढ़ाने के लिए सिक्कों से अपग्रेड खरीदें। अंत में सबसे अधिक प्रकाश वाला खिलाड़ी जीतता है!
# Actions
lightturret-shoot = टरेट को शूट करें
lightturret-upgrade = एक अपग्रेड खरीदें (10 सिक्के)
lightturret-check-stats = आंकड़े जांचें
lightturret-not-enough-coins = आपके पास पर्याप्त सिक्के नहीं हैं! { $need } सिक्कों की आवश्यकता है लेकिन केवल { $have } हैं।
# Disabled action reasons
lightturret-you-are-eliminated = आप बाहर हो चुके हैं।
# Stats
lightturret-stats-alive = { $player }: { $power } शक्ति, { $light } प्रकाश, { $coins } सिक्के।
lightturret-stats-eliminated = { $player }: { $light } प्रकाश के साथ बाहर।
# Options
lightturret-set-starting-power = प्रारंभिक शक्ति: { $power }
lightturret-enter-starting-power = प्रारंभिक शक्ति दर्ज करें:
lightturret-option-changed-power = प्रारंभिक शक्ति { $power } पर सेट की गई।
lightturret-set-max-rounds = अधिकतम राउंड: { $rounds }
lightturret-enter-max-rounds = अधिकतम राउंड दर्ज करें:
lightturret-option-changed-rounds = अधिकतम राउंड { $rounds } पर सेट किए गए।
