# lightturret.ftl for locale sl. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Svetlobni Stolp
# Intro
lightturret-intro = Svetlobni Stolp se je začel! Vsak igralec ima stolp z { $power } moči. Streljajte v stolp, da dobite svetlobo in kovance, a če vaša svetloba preseže vašo moč, ste izločeni! Kupite nadgradnje s kovanci, da povečate svojo moč. Igralec z največ svetlobe na koncu zmaga!
# Actions
lightturret-shoot = Streljaj v stolp
lightturret-upgrade = Kupi nadgradnjo (10 kovancev)
lightturret-check-stats = Preveri statistiko
lightturret-not-enough-coins = Nimate dovolj kovancev! Potrebujete { $need } kovancev, a imate samo { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Bili ste izločeni.
# Stats
lightturret-stats-alive = { $player }: { $power } moči, { $light } svetlobe, { $coins } kovancev.
lightturret-stats-eliminated = { $player }: izločen s { $light } svetlobe.
# Options
lightturret-set-starting-power = Začetna moč: { $power }
lightturret-enter-starting-power = Vnesite začetno moč:
lightturret-option-changed-power = Začetna moč nastavljena na { $power }.
lightturret-set-max-rounds = Maksimalni krogi: { $rounds }
lightturret-enter-max-rounds = Vnesite maksimalne kroge:
lightturret-option-changed-rounds = Maksimalni krogi nastavljeni na { $rounds }.
