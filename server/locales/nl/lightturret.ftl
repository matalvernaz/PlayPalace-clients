# lightturret.ftl for locale nl. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Light Turret
# Intro
lightturret-intro = Light Turret is begonnen! Elke speler heeft een toren met { $power } kracht. Schiet op de toren om licht en munten te verdienen, maar als je licht je kracht overschrijdt, ben je geëlimineerd! Koop upgrades met munten om je kracht te verhogen. De speler met het meeste licht aan het einde wint!
# Actions
lightturret-shoot = Schiet op de toren
lightturret-upgrade = Koop een upgrade (10 munten)
lightturret-check-stats = Bekijk statistieken
lightturret-not-enough-coins = Je hebt niet genoeg munten! Nodig { $need } munten maar hebt slechts { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Je bent geëlimineerd.
# Stats
lightturret-stats-alive = { $player }: { $power } kracht, { $light } licht, { $coins } munten.
lightturret-stats-eliminated = { $player }: geëlimineerd met { $light } licht.
# Options
lightturret-set-starting-power = Startkracht: { $power }
lightturret-enter-starting-power = Voer startkracht in:
lightturret-option-changed-power = Startkracht ingesteld op { $power }.
lightturret-set-max-rounds = Max rondes: { $rounds }
lightturret-enter-max-rounds = Voer max rondes in:
lightturret-option-changed-rounds = Max rondes ingesteld op { $rounds }.
