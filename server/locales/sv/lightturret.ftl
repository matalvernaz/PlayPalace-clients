# lightturret.ftl for locale sv. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Ljustornet
# Intro
lightturret-intro = Ljustornet har börjat! Varje spelare har ett torn med { $power } kraft. Skjut på tornet för att få ljus och mynt, men om ditt ljus överstiger din kraft är du utslagen! Köp uppgraderingar med mynt för att öka din kraft. Spelaren med mest ljus i slutet vinner!
# Actions
lightturret-shoot = Skjut på tornet
lightturret-upgrade = Köp en uppgradering (10 mynt)
lightturret-check-stats = Kontrollera statistik
lightturret-not-enough-coins = Du har inte tillräckligt med mynt! Behöver { $need } mynt men har bara { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Du har blivit utslagen.
# Stats
lightturret-stats-alive = { $player }: { $power } kraft, { $light } ljus, { $coins } mynt.
lightturret-stats-eliminated = { $player }: utslagen med { $light } ljus.
# Options
lightturret-set-starting-power = Startkraft: { $power }
lightturret-enter-starting-power = Ange startkraft:
lightturret-option-changed-power = Startkraft inställd på { $power }.
lightturret-set-max-rounds = Max rundor: { $rounds }
lightturret-enter-max-rounds = Ange max rundor:
lightturret-option-changed-rounds = Max rundor inställda på { $rounds }.
