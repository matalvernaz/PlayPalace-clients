# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Oyun adı
game-name-lightturret = Light Turret
# Tanıtım
lightturret-intro = Light Turret başladı! Her oyuncunun { $power } güçlü bir kulesi var. Işık ve jeton kazanmak için kuleyi vur, ama ışığın gücünü aşarsa elenirsin! Gücünü artırmak için jetonlarla yükseltme satın al. Sonda en çok ışığa sahip oyuncu kazanır!
# Eylemler
lightturret-shoot = Kuleyi vur
lightturret-upgrade = Yükseltme satın al (10 jeton)
lightturret-check-stats = İstatistikleri kontrol et
lightturret-not-enough-coins = Yeterli jetonun yok! { $need } jeton gerekli ama sadece { $have } var.
# Devre dışı eylem nedenleri
lightturret-you-are-eliminated = Elendiniz.
# İstatistikler
lightturret-stats-alive = { $player }: { $power } güç, { $light } ışık, { $coins } jeton.
lightturret-stats-eliminated = { $player }: { $light } ışık ile elendi.
# Seçenekler
lightturret-set-starting-power = Başlangıç gücü: { $power }
lightturret-enter-starting-power = Başlangıç gücünü girin:
lightturret-option-changed-power = Başlangıç gücü { $power } olarak ayarlandı.
lightturret-set-max-rounds = Maksimum raund: { $rounds }
lightturret-enter-max-rounds = Maksimum raund girin:
lightturret-option-changed-rounds = Maksimum raund { $rounds } olarak ayarlandı.
