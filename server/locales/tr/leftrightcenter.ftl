# leftrightcenter.ftl for locale tr. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Oyun adı
game-name-leftrightcenter = Left Right Center
# Eylemler
lrc-roll =
    { $count } { $count ->
        [one] zar
       *[other] zar
    } at
# Zar yüzleri
lrc-face-left = Sol
lrc-face-center = Merkez
lrc-face-right = Sağ
lrc-face-dot = Nokta
lrc-center-pot =
    Merkezde { $count } { $count ->
        [one] jeton
       *[other] jeton
    }.
# Seçenekler
lrc-set-starting-chips = Başlangıç jetonları: { $count }
lrc-enter-starting-chips = Başlangıç jetonlarını girin:
lrc-option-changed-starting-chips = Başlangıç jetonları { $count } olarak ayarlandı.
