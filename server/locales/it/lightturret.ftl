# lightturret.ftl for locale it. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Torre di Luce
# Intro
lightturret-intro = La Torre di Luce è iniziata! Ogni giocatore ha una torre con { $power } potenza. Spara alla torre per ottenere luce e monete, ma se la tua luce supera la tua potenza, sei eliminato! Compra potenziamenti con le monete per aumentare la tua potenza. Il giocatore con più luce alla fine vince!
# Actions
lightturret-shoot = Spara alla torre
lightturret-upgrade = Compra un potenziamento (10 monete)
lightturret-check-stats = Controlla statistiche
lightturret-not-enough-coins = Non hai abbastanza monete! Servono { $need } monete ma ne hai solo { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Sei stato eliminato.
# Stats
lightturret-stats-alive = { $player }: { $power } potenza, { $light } luce, { $coins } monete.
lightturret-stats-eliminated = { $player }: eliminato con { $light } luce.
# Options
lightturret-set-starting-power = Potenza iniziale: { $power }
lightturret-enter-starting-power = Inserisci potenza iniziale:
lightturret-option-changed-power = Potenza iniziale impostata a { $power }.
lightturret-set-max-rounds = Round massimi: { $rounds }
lightturret-enter-max-rounds = Inserisci round massimi:
lightturret-option-changed-rounds = Round massimi impostati a { $rounds }.
