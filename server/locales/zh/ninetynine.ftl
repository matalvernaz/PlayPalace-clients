# ninetynine.ftl for locale zh. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# 游戏名称
game-name-ninetynine = 九十九
# 回合
ninetynine-round = 第 { $round } 轮。
# 出牌 - 与v10完全匹配
ninetynine-you-play = 你出了 { $card }。计数现在是 { $count }。
ninetynine-player-plays = { $player } 出了 { $card }。计数现在是 { $count }。
# 方向反转
ninetynine-direction-reverses = 出牌方向反转！
# 跳过
ninetynine-player-skipped = { $player } 被跳过。
# 筹码损失 - 与v10完全匹配
ninetynine-you-lose-tokens = 你失去了 { $amount } 个筹码。
ninetynine-player-loses-tokens = { $player } 失去了 { $amount } 个筹码。
# 淘汰
ninetynine-player-eliminated = { $player } 被淘汰了！
# 游戏结束
ninetynine-player-wins = { $player } 赢得了游戏！
# 抽牌
ninetynine-you-draw = 你抽到了 { $card }。
ninetynine-player-draws = { $player } 抽了一张牌。
# 没有有效牌
ninetynine-no-valid-cards = { $player } 没有不会超过99的牌！
# 状态 - 用于C键
ninetynine-current-count = 计数是 { $count }。
# A的选择
ninetynine-ace-choice = A出为+1还是+11？
ninetynine-ace-add-eleven = 加11
ninetynine-ace-add-one = 加1
# 10的选择
ninetynine-ten-choice = 10出为+10还是-10？
ninetynine-ten-add = 加10
ninetynine-ten-subtract = 减10
# 手动抽牌
ninetynine-draw-card = 抽牌
ninetynine-draw-prompt = 按空格或D键抽一张牌。
# 选项
ninetynine-set-tokens = 起始筹码：{ $tokens }
ninetynine-enter-tokens = 输入起始筹码数量：
ninetynine-option-changed-tokens = 起始筹码设置为 { $tokens }。
ninetynine-set-rules = 规则变体：{ $rules }
ninetynine-select-rules = 选择规则变体
ninetynine-option-changed-rules = 规则变体设置为 { $rules }。
ninetynine-set-hand-size = 手牌数量：{ $size }
ninetynine-enter-hand-size = 输入手牌数量：
ninetynine-option-changed-hand-size = 手牌数量设置为 { $size }。
ninetynine-set-autodraw = 自动抽牌：{ $enabled }
ninetynine-option-changed-autodraw = 自动抽牌设置为 { $enabled }。
# 操作禁用原因
ninetynine-choose-first = 你需要先做出选择。
