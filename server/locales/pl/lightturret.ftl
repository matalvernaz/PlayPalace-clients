# lightturret.ftl for locale pl. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Light Turret
# Intro
lightturret-intro = Light Turret has begun! Each player has a turret with { $power } power. Shoot the turret to gain light and coins, but if your light exceeds your power, you're eliminated! Buy upgrades with coins to increase your power. The player with the most light at the end wins!
# Actions
lightturret-shoot = Shoot the turret
lightturret-upgrade = Buy an upgrade (10 coins)
lightturret-check-stats = Check stats
lightturret-not-enough-coins = You don't have enough coins! Need { $need } coins but only have { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = You have been eliminated.
# Stats
lightturret-stats-alive = { $player }: { $power } power, { $light } light, { $coins } coins.
lightturret-stats-eliminated = { $player }: eliminated with { $light } light.
# Options
lightturret-set-starting-power = Starting power: { $power }
lightturret-enter-starting-power = Enter starting power:
lightturret-option-changed-power = Starting power set to { $power }.
lightturret-set-max-rounds = Max rounds: { $rounds }
lightturret-enter-max-rounds = Enter max rounds:
lightturret-option-changed-rounds = Max rounds set to { $rounds }.
