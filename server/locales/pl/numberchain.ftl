# Number Chain — pl

game-name-numberchain = Number Chain

# Game start
numberchain-game-started = { $p1 } to gracz 1, { $p2 } to gracz 2. { $first } zaczyna. Połóż 1 w dowolnym miejscu, aby rozpocząć łańcuch.

# Placement
numberchain-place-you = Kładziesz { $number } w wierszu { $row }, kolumnie { $col }.
numberchain-place-other = { $player } kładzie { $number } w wierszu { $row }, kolumnie { $col }.

# Errors
numberchain-illegal-move = Ten ruch jest niedozwolony.

# Status / info
numberchain-status = Ruch gracza { $current }. Następna liczba: { $required }.
numberchain-inventory = Twoje pozostałe płytki: { $inventory }.
numberchain-required = Następna liczba do położenia: { $required }.

# Square labels
numberchain-sq-empty = Wiersz { $row }, kolumna { $col }, puste
numberchain-sq-own = Wiersz { $row }, kolumna { $col }, { $number }, twoje
numberchain-sq-opponent = Wiersz { $row }, kolumna { $col }, { $number }, { $owner }

# Action labels
numberchain-check-status = Status
numberchain-check-inventory = Ekwipunek
numberchain-check-required = Następna liczba

# Win
numberchain-wins = { $player } wygrywa! Przeciwnik nie ma legalnych ruchów.
numberchain-final = { $winner } wygrywa.

# Options
numberchain-option-bot-difficulty = Poziom bota: { $bot_difficulty }
numberchain-option-select-bot-difficulty = Wybierz poziom bota
numberchain-option-changed-bot-difficulty = Poziom bota ustawiony na { $bot_difficulty }.
numberchain-difficulty-random = Losowy
numberchain-difficulty-simple = Prosty
