# lightturret.ftl for locale de. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Spielname
game-name-lightturret = Light Turret
# Einführung
lightturret-intro = Light Turret hat begonnen! Jeder Spieler hat einen Turm mit { $power } Kraft. Schießen Sie auf den Turm, um Licht und Münzen zu erhalten, aber wenn Ihr Licht Ihre Kraft überschreitet, werden Sie eliminiert! Kaufen Sie Upgrades mit Münzen, um Ihre Kraft zu erhöhen. Der Spieler mit dem meisten Licht am Ende gewinnt!
# Aktionen
lightturret-shoot = Auf den Turm schießen
lightturret-upgrade = Ein Upgrade kaufen (10 Münzen)
lightturret-check-stats = Statistiken prüfen
lightturret-not-enough-coins = Sie haben nicht genug Münzen! Brauche { $need } Münzen, habe aber nur { $have }.
# Gründe für deaktivierte Aktionen
lightturret-you-are-eliminated = Sie wurden eliminiert.
# Statistiken
lightturret-stats-alive = { $player }: { $power } Kraft, { $light } Licht, { $coins } Münzen.
lightturret-stats-eliminated = { $player }: eliminiert mit { $light } Licht.
# Optionen
lightturret-set-starting-power = Startkraft: { $power }
lightturret-enter-starting-power = Startkraft eingeben:
lightturret-option-changed-power = Startkraft auf { $power } gesetzt.
lightturret-set-max-rounds = Max. Runden: { $rounds }
lightturret-enter-max-rounds = Max. Runden eingeben:
lightturret-option-changed-rounds = Max. Runden auf { $rounds } gesetzt.
