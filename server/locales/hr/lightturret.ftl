# lightturret.ftl for locale hr. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# Game name
game-name-lightturret = Svjetlosna Kula
# Intro
lightturret-intro = Svjetlosna Kula je počela! Svaki igrač ima kulu sa { $power } snage. Pucajte na kulu kako biste dobili svjetlo i novčiće, ali ako vaše svjetlo premaši vašu snagu, eliminirani ste! Kupujte nadogradnje novčićima kako biste povećali svoju snagu. Igrač s najviše svjetla na kraju pobjeđuje!
# Actions
lightturret-shoot = Pucaj na kulu
lightturret-upgrade = Kupi nadogradnju (10 novčića)
lightturret-check-stats = Provjeri statistiku
lightturret-not-enough-coins = Nemate dovoljno novčića! Potrebno { $need } novčića, ali imate samo { $have }.
# Disabled action reasons
lightturret-you-are-eliminated = Eliminirani ste.
# Stats
lightturret-stats-alive = { $player }: { $power } snage, { $light } svjetla, { $coins } novčića.
lightturret-stats-eliminated = { $player }: eliminiran sa { $light } svjetla.
# Options
lightturret-set-starting-power = Početna snaga: { $power }
lightturret-enter-starting-power = Unesite početnu snagu:
lightturret-option-changed-power = Početna snaga postavljena na { $power }.
lightturret-set-max-rounds = Maksimalno rundi: { $rounds }
lightturret-enter-max-rounds = Unesite maksimalno rundi:
lightturret-option-changed-rounds = Maksimalno rundi postavljeno na { $rounds }.
