# lightturret.ftl for locale ja. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# ゲーム名
game-name-lightturret = ライトタレット
# 紹介
lightturret-intro = ライトタレットが始まりました!各プレイヤーは{ $power }パワーのタレットを持っています。タレットを撃ってライトとコインを獲得しますが、ライトがパワーを超えると敗退します!コインでアップグレードを購入してパワーを増やしましょう。最後に最もライトを持っているプレイヤーが勝利します!
# アクション
lightturret-shoot = タレットを撃つ
lightturret-upgrade = アップグレードを購入(10コイン)
lightturret-check-stats = 統計を確認
lightturret-not-enough-coins = コインが足りません!{ $need }コイン必要ですが、{ $have }コインしかありません。
# アクション無効理由
lightturret-you-are-eliminated = あなたは敗退しました。
# 統計
lightturret-stats-alive = { $player }: { $power }パワー、{ $light }ライト、{ $coins }コイン。
lightturret-stats-eliminated = { $player }: { $light }ライトで敗退。
# オプション
lightturret-set-starting-power = 開始パワー: { $power }
lightturret-enter-starting-power = 開始パワーを入力:
lightturret-option-changed-power = 開始パワーが{ $power }に設定されました。
lightturret-set-max-rounds = 最大ラウンド: { $rounds }
lightturret-enter-max-rounds = 最大ラウンドを入力:
lightturret-option-changed-rounds = 最大ラウンドが{ $rounds }に設定されました。
