# ninetynine.ftl for locale ja. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# ゲーム名
game-name-ninetynine = Ninety Nine
# ラウンド
ninetynine-round = ラウンド{ $round }。
# カードのプレイ
ninetynine-you-play = あなたは{ $card }をプレイしました。カウントは現在{ $count }です。
ninetynine-player-plays = { $player }は{ $card }をプレイしました。カウントは現在{ $count }です。
# 方向転換
ninetynine-direction-reverses = プレイの方向が逆になります!
# スキップ
ninetynine-player-skipped = { $player }はスキップされました。
# トークン喪失
ninetynine-you-lose-tokens = あなたは{ $amount }個のトークンを失いました。
ninetynine-player-loses-tokens = { $player }は{ $amount }個のトークンを失いました。
# 敗退
ninetynine-player-eliminated = { $player }は敗退しました!
# ゲーム終了
ninetynine-player-wins = { $player }がゲームに勝利しました!
# カードをドロー
ninetynine-you-draw = あなたは{ $card }をドローしました。
ninetynine-player-draws = { $player }がカードをドローしました。
# 有効なカードがない
ninetynine-no-valid-cards = { $player }は99を超えないカードを持っていません!
# ステータス
ninetynine-current-count = カウントは{ $count }です。
# エースの選択
ninetynine-ace-choice = エースを+1か+11でプレイしますか?
ninetynine-ace-add-eleven = 11を追加
ninetynine-ace-add-one = 1を追加
# 10の選択
ninetynine-ten-choice = 10を+10か-10でプレイしますか?
ninetynine-ten-add = 10を追加
ninetynine-ten-subtract = 10を引く
# 手動ドロー
ninetynine-draw-card = カードをドロー
ninetynine-draw-prompt = スペースまたはDを押してカードをドローします。
# オプション
ninetynine-set-tokens = 開始トークン: { $tokens }
ninetynine-enter-tokens = 開始トークン数を入力:
ninetynine-option-changed-tokens = 開始トークンが{ $tokens }に設定されました。
ninetynine-set-rules = ルールバリアント: { $rules }
ninetynine-select-rules = ルールバリアントを選択
ninetynine-option-changed-rules = ルールバリアントが{ $rules }に設定されました。
ninetynine-set-hand-size = ハンドサイズ: { $size }
ninetynine-enter-hand-size = ハンドサイズを入力:
ninetynine-option-changed-hand-size = ハンドサイズが{ $size }に設定されました。
ninetynine-set-autodraw = 自動ドロー: { $enabled }
ninetynine-option-changed-autodraw = 自動ドローが{ $enabled }に設定されました。
# アクション無効理由
ninetynine-choose-first = まず選択する必要があります。
