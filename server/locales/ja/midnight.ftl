# midnight.ftl for locale ja. Messages missing here are spoken in English.
# Merged from PlayAural and this server by tools/merge_playaural_locales.py.

# ゲーム情報
game-name-midnight = 1-4-24
# アクション
midnight-roll = サイコロをロール
midnight-bank = バンク
midnight-you-rolled = あなたは{ $dice }をロールしました。
midnight-player-rolled = { $player }は{ $dice }をロールしました。
# サイコロの保持
midnight-you-keep = あなたは{ $die }を保持します。
midnight-player-keeps = { $player }は{ $die }を保持します。
midnight-you-unkeep = あなたは{ $die }の保持を解除します。
midnight-player-unkeeps = { $player }は{ $die }の保持を解除します。
# スコアリング
midnight-you-scored = あなたは{ $score }点を獲得しました。
midnight-scored = { $player }は{ $score }点を獲得しました。
midnight-you-disqualified = 1と4の両方がありません。失格です!
midnight-player-disqualified = { $player }は1と4の両方がなく失格です!
# ラウンド結果
midnight-round-winner = { $player }がラウンドに勝利!
midnight-round-tie = { $players }間で引き分け。
midnight-all-disqualified = 全員失格!このラウンドの勝者はいません。
# ゲーム勝者
midnight-game-winner = { $player }が{ $wins }ラウンド勝利でゲームに勝利!
midnight-game-tie = 引き分けです!{ $players }が各{ $wins }ラウンド勝利しました。
# オプション
midnight-set-rounds = プレイするラウンド: { $rounds }
midnight-enter-rounds = プレイするラウンド数を入力:
midnight-option-changed-rounds = プレイするラウンド数が{ $rounds }に変更されました
# アクション無効理由
midnight-need-to-roll = まずサイコロをロールする必要があります。
midnight-no-dice-to-keep = 保持できるサイコロがありません。
midnight-must-keep-one = ロールごとに少なくとも1個保持する必要があります。
midnight-must-roll-first = まずサイコロをロールする必要があります。
midnight-keep-all-first = バンクする前にすべてのサイコロを保持する必要があります。
